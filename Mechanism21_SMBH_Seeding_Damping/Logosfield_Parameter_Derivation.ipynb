import sympy as sp

# === QFT: Gamma from Scalar Mass (hbar = 1 in natural units) ===
m_phi = sp.symbols('m_phi')
hbar = 1  # Natural units
gamma = sp.sqrt(m_phi / hbar)

print("Gamma from QFT Decay:")
sp.pprint(gamma)

# === Cosmology: Beta from Phase Resonance ===
beta = 2 * sp.pi
print("\nBeta from Resonance:")
sp.pprint(beta)

# === Fit to JWST Data (z=10, t~700 Myr) ===
t_obs = 700  # Myr
gamma_val = 0.005
m_phi_val = gamma_val**2 * hbar  # hbar = 1

print(f"\nImplied Scalar Mass (m_phi): {float(m_phi_val):.2e} (natural units)")
print(f"Memory Lifetime: {1/gamma_val:.0f} Myr")

# === Damping at z=10 ===
damping = 1 - sp.exp(-gamma * t_obs)
print(f"\nDamping at z=10: {float(damping.subs(gamma, gamma_val)):.3f}")
print("Scaled to 29.5% via observable fraction.")
