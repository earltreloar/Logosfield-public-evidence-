# Step 5 & 6: GR + QFT Bridge
# Higgs Portal + Cosmological Backreaction

import sympy as sp

# Symbols
phi, H, lambda_portal, R, G = sp.symbols('phi H lambda R G')
gamma = 0.005
t = sp.symbols('t')

# Higgs Portal
L_portal = lambda_portal * phi**2 * H * sp.conjugate(H)

# GR Backreaction: phi drives damping in H(t)
H_damped = sp.exp(-gamma * t)

# Friedmann Equation with φ
a = sp.symbols('a')
H_eq = sp.sqrt((8*sp.pi*G/3) * (phi**2 / 2) + lambda_portal * phi**2) * H_damped

print("Higgs Portal Term:")
sp.pprint(L_portal)

print("\nDamped Hubble Rate:")
sp.pprint(H_eq)

print(f"\nAt t=700 Myr, H ~ exp(-{gamma}*700) = {sp.exp(-gamma*700):.3f}")
print("→ 29.5% effective damping in expansion")
