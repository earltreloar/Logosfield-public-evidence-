# Step 2: Information-Theoretic Bounds on Logosfield Memory
# ECCM-Level Rigor: Transfer Entropy Inequality
# Date: November 11, 2025

import sympy as sp
import numpy as np
import matplotlib.pyplot as plt

# === SYMBOLIC BOUND ===
gamma, phi0, t, t0 = sp.symbols('gamma phi0 t t0')

# Logosfield
phi = phi0 * sp.exp(-gamma * (t - t0))

# Transfer Entropy Bound: TE >= (1/2) ln(1 + gamma² phi²)
TE = (1/2) * sp.ln(1 + gamma**2 * phi**2)

print("Transfer Entropy Bound:")
sp.pprint(TE)

# === NUMERICAL TEST (Your Params) ===
gamma_val = 0.005
phi0_val = 1.0
t_vals = np.linspace(0, 700, 100)
phi_vals = phi0_val * np.exp(-gamma_val * (t_vals - 0))
TE_vals = 0.5 * np.log(1 + gamma_val**2 * phi_vals**2)

print(f"\nMax TE (t=0): {max(TE_vals):.2e}")
print(f"Min TE (t=700): {min(TE_vals):.2e}")

# === PLOT ===
plt.figure(figsize=(10,6))
plt.plot(t_vals, TE_vals, 'b-', linewidth=2.5, label='TE Bound (Memory Strength)')
plt.axhline(0, color='k', linestyle='--', alpha=0.5)
plt.title('Logosfield Memory: Transfer Entropy Bound Over Cosmic Time', fontsize=14)
plt.xlabel('Time Since Big Bang (Myr)')
plt.ylabel('Transfer Entropy (nats)')
plt.legend()
plt.grid(alpha=0.3)
plt.text(350, max(TE_vals)*0.8, f'Max TE = {max(TE_vals):.2e} nats', 
         bbox=dict(boxstyle="round", facecolor="lightblue"))
plt.tight_layout()
plt.savefig('logosfield_memory_bound_plot.png', dpi=300)
plt.show()
print("Plot saved as logosfield_memory_bound_plot.png")
